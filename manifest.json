{
  "manifest_version": 3,
  "name": "MiniTab Quick Search",
  "version": "1.0.0",
  "description": "Search anything in a tiny floating window without leaving your current tab.",
  "permissions": ["storage","windows","system.display"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open MiniTab quick search"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open MiniTab quick search"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
